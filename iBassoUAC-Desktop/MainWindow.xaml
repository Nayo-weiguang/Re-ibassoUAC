<Window x:Class="iBassoUAC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iBasso UAC 桌面控制台 (Studio Console Edition)" Height="780" Width="1200"
        MinHeight="680" MinWidth="1020"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshStateCommand}" />
  </Window.InputBindings>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== 顶部全局导航栏 Header ==================== -->
    <Border Grid.Row="0" Margin="0,0,0,16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左侧标题与产品说明 -->
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
            <TextBlock Text="iBasso UAC" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <Border Margin="10,0,0,0" Background="{StaticResource AccentSoftBgBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="STUDIO CONSOLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <Border Margin="6,0,0,0" Background="{StaticResource HiResGoldBgBrush}" BorderBrush="{StaticResource HiResGoldBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="Hi-Res AUDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource HiResGoldBrush}" />
            </Border>
          </StackPanel>
          <TextBlock Text="基于官方 iBasso UAC 2.1.9 (com.ibasso.volume) 协议与官方命名规范实现"
                     Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>

        <!-- 右侧连接状态看板 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
            <TextBlock Text="{Binding ConnectionBadgeText}" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <Border Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12,6">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== 主工作区 Main Content ==================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ==================== 左侧：USB 设备清单 ==================== -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 1. 列表头部与刷新按钮 -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="USB 设备清单" Style="{StaticResource H1}" VerticalAlignment="Center" Margin="0" />
            <Button Grid.Column="1" Content="↻ 刷新" Command="{Binding RefreshCommand}" Padding="10,4" />
          </Grid>

          <!-- 2. 智能外设过滤器 -->
          <Border Grid.Row="1" Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <CheckBox Content="显示全部 HID 外设 (含键鼠/灯控)" IsChecked="{Binding ShowAllDevices}" />
              <TextBlock Text="默认仅展示 iBasso DAC 及其音频设备，过滤键盘多重接口等无关干扰。"
                         Style="{StaticResource SmallCaption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 3. 自适应设备列表 -->
          <ListBox Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- 设备名称 -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"
                             FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                  <!-- 设备类型分类徽章 -->
                  <Border Grid.Row="0" Grid.Column="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                          VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E2536" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsIbasoFamily}" Value="True">
                            <Setter Property="Background" Value="{StaticResource HiResGoldBgBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource HiResGoldBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CategoryTag}" FontSize="10" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource FgSecondaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIbasoFamily}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource HiResGoldBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>

                  <!-- 硬件 VID:PID 与制造商信息 -->
                  <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Subtitle}"
                             Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 4. 连接与断开操作按钮 -->
          <Grid Grid.Row="3" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="建立连接" Style="{StaticResource Primary}" Command="{Binding ConnectCommand}" />
            <Button Grid.Column="2" Content="断开连接" Style="{StaticResource Danger}" Command="{Binding DisconnectCommand}" />
          </Grid>

          <!-- 5. 底部系统安全提示 -->
          <Border Grid.Row="4" Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="10">
            <StackPanel>
              <TextBlock Text="🛡️ 硬件免驱提示" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2" />
              <TextBlock Text="控制通道完全使用系统自带 hidusb.sys 驱动。无需替换 WinUSB，不影响日常声音播放。"
                         Style="{StaticResource SmallCaption}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ==================== 右侧：核心功能选项卡 ==================== -->
      <TabControl Grid.Column="2">

        <!-- ==================== Tab 1: 音量 (官方 App 命名) ==================== -->
        <TabItem Header="音量">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">

              <!-- 1. 硬件芯片与控制通道看板 (Hardware Banner) -->
              <Border Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <TextBlock Text="当前解码器架构：" Style="{StaticResource Muted}" FontSize="12" />
                      <TextBlock Text="{Binding HardwareChipSummary}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource HiResGoldBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HardwareInterfaceSummary}" Style="{StaticResource SmallCaption}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="读取硬件状态 (F5)" Command="{Binding RefreshStateCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- 2. 主音量控制卡片 (官方: 音量 / PCM音量微调) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="音量" Style="{StaticResource H1}" />
                      <TextBlock Text="硬件级数字步进衰减调节，精准同步设备端音量旋钮与实体按键" Style="{StaticResource Muted}" />
                    </StackPanel>

                    <!-- 大字号声学分贝读数 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding VolumeDb, StringFormat={}{0:0.0}}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text=" dB" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                      </StackPanel>
                      <TextBlock Text="{Binding VolumeIndex, StringFormat=音量档位: {0} / 100}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>

                  <!-- 主音量滑块 -->
                  <Slider Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding VolumeIndex}"
                          TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,14" />

                  <!-- 控制工具栏：PCM音量微调与预设按钮 -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：微调步进与静音 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <Button Content="－ 1 档" Command="{Binding VolumeStepDownCommand}" Margin="0,0,6,0" Padding="12,5" />
                      <Button Content="＋ 1 档" Command="{Binding VolumeStepUpCommand}" Margin="0,0,10,0" Padding="12,5" />
                      <Button Content="🔇 静音" Command="{Binding MuteCommand}" Style="{StaticResource Danger}" Padding="12,5" />
                    </StackPanel>

                    <!-- 右侧：快捷预设档位胶囊按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock Text="快捷档位：" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <Button Content="30%" Style="{StaticResource PillButton}" Command="{Binding SetPresetVolumeCommand}" CommandParameter="30" Margin="0,0,6,0" />
                      <Button Content="50%" Style="{StaticResource PillButton}" Command="{Binding SetPresetVolumeCommand}" CommandParameter="50" Margin="0,0,6,0" />
                      <Button Content="70% 舒适" Style="{StaticResource PillButton}" Command="{Binding SetPresetVolumeCommand}" CommandParameter="70" Margin="0,0,6,0" />
                      <Button Content="100% 满幅" Style="{StaticResource PillButton}" Command="{Binding SetPresetVolumeCommand}" CommandParameter="100" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 3. 声道平衡卡片 (官方: 声道平衡 - 自适应流式高度) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="声道平衡" Style="{StaticResource H1}" />
                      <TextBlock Text="微调左右耳听感平衡偏置（0 档为中置平衡）" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="重置归零 (0)" Command="{Binding ResetBalanceCommand}" Padding="12,4" />
                  </Grid>

                  <!-- 声道平衡滑块与指示 -->
                  <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="◀ 左 (L)" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                    <Slider Grid.Column="1" Minimum="-20" Maximum="20" Value="{Binding Balance}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0" />
                    <TextBlock Grid.Column="2" Text="右 (R) ▶" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                  </Grid>

                  <TextBlock Text="{Binding Balance, StringFormat=当前声道偏移量：{0} 档}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <!-- 4. 双向同步说明卡片 -->
              <Border Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel>
                    <TextBlock Text="硬件状态双向跟随已激活" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="当在 DAC 实体按键或旋钮调节音量时，桌面控制台将自动同步跟随硬件上报。" Style="{StaticResource SmallCaption}" Margin="0,2,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ==================== Tab 2: 声音设置 (官方 App 命名) ==================== -->
        <TabItem Header="声音设置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">

              <!-- 卡片 1: 数字滤波 (官方 App: 数字滤波) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="数字滤波" Style="{StaticResource H1}" />
                    <TextBlock Text="选择 DAC 内部数字重构滤波器算法，调节脉冲响应与高频衰减曲线" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <ComboBox Grid.Row="1" ItemsSource="{Binding DigitalFilterOptions}"
                            SelectedItem="{Binding SelectedDigitalFilterOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>

              <!-- 卡片 2: 增益 (官方 App: 增益) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="增益" Style="{StaticResource H1}" />
                    <TextBlock Text="设置模拟放大器输出增益等级。高灵敏耳塞建议使用低增益以保持零底噪" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <ComboBox Grid.Row="1" ItemsSource="{Binding GainOptions}"
                            SelectedItem="{Binding SelectedGainOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>

              <!-- 卡片 3: 输出模式 (官方 App: 输出模式 普通 / 增压) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="输出模式" Style="{StaticResource H1}" />
                    <TextBlock Text="设置模拟输出推力模式（普通标准输出 / 增压高推力输出）" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <ComboBox Grid.Row="1" ItemsSource="{Binding OutputOptions}"
                            SelectedItem="{Binding SelectedOutputOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>

              <!-- 卡片 4: 同轴输出 (官方 App: 同轴输出 关 / 开) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="同轴输出" Style="{StaticResource H1}" />
                    <TextBlock Text="启用 SP/DIF 同轴数字音频输出，将 USB 数据流转送给外部独立解码器" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <ComboBox Grid.Row="1" ItemsSource="{Binding SpdifOptions}" SelectedIndex="{Binding Spdif}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>

              <!-- 卡片 5: 工作模式 (官方 App: 工作模式 普通 / 省电模式 / 超级) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="工作模式" Style="{StaticResource H1}" />
                    <TextBlock Text="设置内部音频耳放级驱动功耗与动态响应模式" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <ComboBox Grid.Row="1" ItemsSource="{Binding AmpModeOptions}" SelectedIndex="{Binding AmpMode}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>

              <!-- 卡片 6: DSD滤波 (官方 App: DSD滤波) -->
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DSD滤波" Style="{StaticResource H1}" />
                    <TextBlock Text="调节 DSD 截止频率与高通滤波响应" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Slider Minimum="0" Maximum="4" Value="{Binding DsdFilter}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding DsdFilter, StringFormat=档位: {0}}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ==================== Tab 3: 均衡器 (官方 App 命名) ==================== -->
        <TabItem Header="均衡器">
          <Grid Margin="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：参数 EQ 频段列表 -->
            <Border Grid.Column="0" Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
              <DataGrid ItemsSource="{Binding Eq.Bands}" AutoGenerateColumns="False" CanUserAddRows="False"
                        Background="Transparent" Foreground="{StaticResource FgBrush}" BorderThickness="0"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}"
                        HeadersVisibility="Column" RowHeight="32">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="频段" Binding="{Binding FilterIndex}" IsReadOnly="True" Width="55" />
                  <DataGridComboBoxColumn Header="滤波器类型" SelectedItemBinding="{Binding SelectedType}" Width="140"
                                          ItemsSource="{Binding TypeOptions}" />
                  <DataGridTextColumn Header="中心频点 (Hz)" Binding="{Binding Frequency}" Width="110" />
                  <DataGridTextColumn Header="增益 (dB)" Binding="{Binding Gain}" Width="85" />
                  <DataGridTextColumn Header="品质系数 (Q)" Binding="{Binding Factor}" Width="85" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <!-- 右侧：预设槽位与操作卡片 -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="预设槽位" Style="{StaticResource H1}" />
                  <Slider Minimum="0" Maximum="2" Value="{Binding EqPresetSlot}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4" />
                  <TextBlock Text="{Binding EqPresetSlot, StringFormat=预设 {0}（映射设备端自定义 7-9）}" Style="{StaticResource Muted}" />

                  <TextBlock Text="总增益 (dB)" Style="{StaticResource H1}" Margin="0,14,0,4" />
                  <TextBox Text="{Binding Eq.TotalGain}" />

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="写入设备" Style="{StaticResource Primary}" Command="{Binding WriteEqCommand}" />
                    <Button Grid.Column="2" Content="读取设置" Command="{Binding ReadEqCommand}" />
                  </Grid>
                  <Button Content="重置为平直曲线" Command="{Binding ResetEqCommand}" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="频响曲线预览" Style="{StaticResource H1}" />
                  <TextBox Text="{Binding EqCurve, Mode=OneWay}" IsReadOnly="True" Height="160"
                           FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </TabItem>

        <!-- ==================== Tab 4: 协议日志 (官方底层诊断) ==================== -->
        <TabItem Header="协议日志">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SubPanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
              <TextBlock Text="实时抓取展示与 iBasso USB 控制接口交互的十六进制报文与响应解析，用于真机核对与底层排障。"
                         Style="{StaticResource Muted}" />
            </Border>
            <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" Background="#0A0C12" BorderBrush="{StaticResource LineBrush}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" AcceptsReturn="True" Padding="10" />
          </Grid>
        </TabItem>

      </TabControl>
    </Grid>
  </Grid>
</Window>
