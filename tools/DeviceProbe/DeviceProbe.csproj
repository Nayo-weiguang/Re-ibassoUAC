<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>iBassoUAC.DeviceProbe</RootNamespace>
    <AssemblyName>DeviceProbe</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\iBassoUAC-Desktop\Interop\**\*.cs" />
    <Compile Include="..\..\iBassoUAC-Desktop\Protocol\**\*.cs" />
    <Compile Include="..\..\iBassoUAC-Desktop\Devices\**\*.cs" />
  </ItemGroup>

</Project>